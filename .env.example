DATABASE_URL="mysql://user:password@host:port/hr_online"
JWT_SECRET="change-this-to-a-random-secret"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
UPLOAD_DIR="./public/uploads"

# ── AI 輔助評分（地端優先、雲端備援）──────────────────────────────
# 考生交卷後「自動」對簡答題生成 AI 初評建議，評卷人進來即可看到並確認/改分。
# ★ 要啟用：至少填一個金鑰 —— 地端（ollama 填任意非空字串）或雲端（deepseek 的 sk-...）。
#   兩個都填 = 地端優先、超時/失敗自動切雲端（推薦，兼顧速度與品質）。
#   都留空 = AI 初評停用，簡答題全人工評分。

# 主要供應商：地端私有閘道（OpenAI 相容）
AI_GRADING_BASE_URL="https://ollamapjapi.theaken.com/v1"
AI_GRADING_MODEL="gemma4:latest"
AI_GRADING_API_KEY=""                 # ← ollama 無需金鑰，填任意非空值即啟用地端
# thinking 模型（gemma4 等）需 >= 1500，否則回應會被截斷成空字串
AI_GRADING_MAX_TOKENS="2000"
# 地端為單機推理，併發無助於吞吐量；建議 1~2，雲端可拉高至 4~8
AI_GRADING_CONCURRENCY="2"
# 地端單次逾時：想「交卷快速出初評」→ 設短一點（如 8000~12000），逾時立刻切雲端
AI_GRADING_PRIMARY_TIMEOUT_MS="12000"
AI_GRADING_PRIMARY_MAX_ATTEMPTS="1"

# 備援供應商：地端異常、逾時或回應無法解析時自動接手
AI_GRADING_FALLBACK_BASE_URL="https://api.deepseek.com/v1"
AI_GRADING_FALLBACK_MODEL="deepseek-chat"
AI_GRADING_FALLBACK_API_KEY=""        # ← 雲端 DeepSeek 金鑰（sk-...），作為地端來不及時的備援
AI_GRADING_FALLBACK_TIMEOUT_MS="60000"
AI_GRADING_FALLBACK_MAX_ATTEMPTS="3"
# 設為 false 可關閉雲端備援（資料完全不出廠）
# AI_GRADING_FALLBACK_ENABLED="false"
# 整體關閉 AI 初評：AI_GRADING_ENABLED="false"
AI_GRADING_FALLBACK_ENABLED="true"

# ── 自動切換機制 ──
# 熔斷：地端連續失敗達門檻後，冷卻期內直接跳過，不再逐筆等逾時
AI_GRADING_BREAKER_THRESHOLD="3"
AI_GRADING_BREAKER_COOLDOWN_MS="300000"
# 品質守門：地端回應可疑時向雲端取第二意見（設 false 可關閉）
AI_GRADING_QUALITY_CHECK="true"
# 得分點超過此數量視為拆太細
AI_GRADING_MAX_KEYPOINTS="8"
# 作答達此字數卻判 0 分視為過嚴誤判
AI_GRADING_ZERO_SCORE_MIN_LENGTH="15"
# 作答長度低於參考答案此比例卻判滿分視為過寬誤判
AI_GRADING_FULL_SCORE_MIN_RATIO="0.25"

# 沿用舊設定：未設定上面的 AI_GRADING_API_KEY 時，主要供應商會改用此金鑰（DeepSeek）
deepseek_api_key=""

# 端點不支援 response_format 時設為 false（程式也會自動偵測降級）
# AI_GRADING_JSON_MODE="auto"
# AI_GRADING_ENABLED="true"

# ── OCR（PDF／圖片轉文字，私有 AI 閘道）──────────────────────────────
# 金鑰僅存於伺服器端，由後端 /api/admin/ocr/* 代理，前端不得接觸
PRIVATE_AI_BASE_URL="https://ollamapjapi.theaken.com/v1"
PRIVATE_AI_API_KEY=""
OCR_ENGINE="paddleocr-remote"
# 單次請求逾時與整個工作的輪詢逾時（毫秒）
# OCR_REQUEST_TIMEOUT_MS="120000"
# OCR_JOB_TIMEOUT_MS="900000"

# ── 後台 AD／LDAP 登入（PRD F2-8）────────────────────────────────────
# API 閘道位址與金鑰；金鑰僅存伺服器端，由 /api/admin/ad/* 代理
AD_URL="https://apigw.panjit.com.tw"
AD_API=""
# 預設網域：本案考場為徐州廠
AD_DEFAULT_DOMAIN="PJXZ"
# AD_TIMEOUT_MS="30000"
