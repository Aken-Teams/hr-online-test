DATABASE_URL="mysql://user:password@host:port/hr_online"
JWT_SECRET="change-this-to-a-random-secret"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
UPLOAD_DIR="./public/uploads"

# ── AI 輔助評分（OpenAI 相容端點；雲端或地端模型皆可）────────────────
# 雲端：DeepSeek
deepseek_api_key=""
# 地端／私有閘道（擇一設定，會覆蓋上面的預設值）
# AI_GRADING_BASE_URL="https://ollamapjapi.theaken.com/v1"
# AI_GRADING_MODEL="gemma4:latest"
# AI_GRADING_API_KEY=""
# thinking 模型（gemma4 等）需 >= 1500，否則回應會被截斷成空字串
# AI_GRADING_MAX_TOKENS="2000"
# 端點不支援 response_format 時設為 false（程式也會自動偵測降級）
# AI_GRADING_JSON_MODE="auto"
# AI_GRADING_ENABLED="true"

# ── OCR（PDF／圖片轉文字，私有 AI 閘道）──────────────────────────────
# 金鑰僅存於伺服器端，由後端 /api/admin/ocr/* 代理，前端不得接觸
PRIVATE_AI_BASE_URL="https://ollamapjapi.theaken.com/v1"
PRIVATE_AI_API_KEY=""
OCR_ENGINE="paddleocr-remote"
# 單次請求逾時與整個工作的輪詢逾時（毫秒）
# OCR_REQUEST_TIMEOUT_MS="120000"
# OCR_JOB_TIMEOUT_MS="900000"
